# Cloudflare R2 Credentials
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token (Object Read & Write)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=buse-berkay-anilar

# Optional: Public Domain or custom domain connected to your R2 bucket (e.g. https://pub-xxxx.r2.dev or https://anilar.berkay.com)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Admin PIN for Buse & Berkay
ADMIN_PIN=9601
